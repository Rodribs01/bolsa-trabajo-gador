# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de datos (la usan docker compose y el backend)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bolsa_trabajo
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Autenticación
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Usuarios creados por los seeders
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Correo
MAIL_DRIVER=consola
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Bolsa de Trabajo GADOR

# Notificaciones push de la PWA
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Archivos subidos
UPLOADS_DIR=uploads
